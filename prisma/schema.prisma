// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum GatePassStatus {
  PENDING
  COLLECTED
  CANCELLED
}

enum GatePassType {
  PERMANENT
  TEMPORARY
}

enum RequestType {
  NEW
  LOST
}

enum PassCategory {
  MAIN
  SUPPLEMENTARY
}

enum Location {
  DOHA_TOWERS
  MESAIEED
  RAS_LAFFAN
  DUKHAN
  OFFSHORE
}

// Delivery / dispatch workflow:
//   ONLINE       — internal team is preparing/validating the file
//   DISPATCH     — ready and waiting for the manager (MED-DARWISH) to assign a field agent
//   ASSIGNED     — manager has set an agent, a scheduled date/time and instructions
//   IN_PROGRESS  — the assigned agent has started the mission
//   COMPLETED    — mission finished
//   BLOCKED      — agent reported a blocker (see blockedReason)
enum DeliveryStage {
  ONLINE
  DISPATCH
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum RequestCategory {
  PRO
  DELIVERY
}

// Account Manager -> Online Operations intake workflow:
//   ASSIGNED_TO_ONLINE           — AM created the request, waiting in the Online Operations queue
//   ONLINE_PROCESSING            — an operator claimed it and is checking documents (claimedBy)
//   PENDING_DISPATCH             — operator validated the file; a DeliveryTask is created for MED-DARWISH
//   MISSING_INFO_RETURNED_TO_AM  — operator sent it back with a comment for the AM to fix with the client
enum RequestStatus {
  ASSIGNED_TO_ONLINE
  ONLINE_PROCESSING
  PENDING_DISPATCH
  MISSING_INFO_RETURNED_TO_AM
}

model Company {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  sector          String?
  contact         String?
  phone           String?
  email           String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  gatePasses      GatePass[]
  deliveryTasks   DeliveryTask[]
  serviceRequests ServiceRequest[]
}

// The full staff roster. Booleans (rather than a single role enum) because
// several people are mixed profiles (e.g. Online + Field, or AM + AM lead).
//   isManager — Dispatch/field manager (MED-DARWISH)
//   isOnline  — Online Operations (delivery prep)
//   isField   — Field/government-trips agent
//   isAM      — Account Manager, initiates client service requests
//   isAMLead  — supervises all AM requests (ELENA); implies isAM
model Employee {
  id               Int                    @id @default(autoincrement())
  name             String                 @unique
  isManager        Boolean                @default(false)
  isOnline         Boolean                @default(false)
  isField          Boolean                @default(false)
  isAM             Boolean                @default(false)
  isAMLead         Boolean                @default(false)
  phone            String?
  email            String?
  active           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  tasksCreated     DeliveryTask[]         @relation("TaskCreatedBy")
  tasksAssignedTo  DeliveryTask[]         @relation("TaskAssignedTo")
  tasksDispatched  DeliveryTask[]         @relation("TaskAssignedBy")
  requestsCreated  ServiceRequest[]       @relation("RequestCreatedBy")
  requestsClaimed  ServiceRequest[]       @relation("RequestClaimedBy")
  requestStatusLog RequestStatusHistory[] @relation("RequestStatusChangedBy")
}

model Collector {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  phone      String?
  email      String?
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  gatePasses GatePass[]
}

model GatePass {
  id            Int            @id @default(autoincrement())
  number        String         @unique
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id])
  location      Location
  gatePassType  GatePassType
  requestType   RequestType
  passCategory  PassCategory
  submittedBy   String
  submissionAt  DateTime
  collectorId   Int?
  collector     Collector?     @relation(fields: [collectorId], references: [id])
  collectionAt  DateTime?
  status        GatePassStatus @default(PENDING)
  remarks       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deliveryTasks DeliveryTask[]

  @@index([status])
  @@index([companyId])
  @@index([collectorId])
  @@index([location])
}

// A delivery/dispatch mission: an online prep step and/or a field trip
// (government office pickup, physical delivery, etc). Optionally tied to
// the GatePass it originated from.
model DeliveryTask {
  id             Int             @id @default(autoincrement())
  gatePassId     Int?
  gatePass       GatePass?       @relation(fields: [gatePassId], references: [id])
  companyId      Int?
  company        Company?        @relation(fields: [companyId], references: [id])
  title          String
  description    String?
  stage          DeliveryStage   @default(ONLINE)
  createdById    Int?
  createdBy      Employee?       @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignedToId   Int?
  assignedTo     Employee?       @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedById   Int?
  assignedBy     Employee?       @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  scheduledAt    DateTime?
  instructions   String?
  startedAt      DateTime?
  completedAt    DateTime?
  blockedReason  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  serviceRequest ServiceRequest?

  @@index([stage])
  @@index([assignedToId])
  @@index([gatePassId])
}

// AM -> Online Operations intake: an Account Manager creates it for a client,
// an Online Operations agent claims and vets it, then either sends it onward
// (a DeliveryTask is created for MED-DARWISH's dispatch board) or bounces it
// back to the AM with a comment when something is missing.
model ServiceRequest {
  id             Int                    @id @default(autoincrement())
  title          String
  category       RequestCategory
  companyId      Int?
  company        Company?               @relation(fields: [companyId], references: [id])
  clientName     String?
  description    String?
  attachments    String?
  status         RequestStatus          @default(ASSIGNED_TO_ONLINE)
  createdById    Int
  createdBy      Employee               @relation("RequestCreatedBy", fields: [createdById], references: [id])
  claimedById    Int?
  claimedBy      Employee?              @relation("RequestClaimedBy", fields: [claimedById], references: [id])
  claimedAt      DateTime?
  returnComment  String?
  deliveryTaskId Int?                   @unique
  deliveryTask   DeliveryTask?          @relation(fields: [deliveryTaskId], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  history        RequestStatusHistory[]

  @@index([status])
  @@index([createdById])
  @@index([claimedById])
}

model RequestStatusHistory {
  id          Int            @id @default(autoincrement())
  requestId   Int
  request     ServiceRequest @relation(fields: [requestId], references: [id])
  fromStatus  RequestStatus?
  toStatus    RequestStatus
  changedById Int?
  changedBy   Employee?      @relation("RequestStatusChangedBy", fields: [changedById], references: [id])
  comment     String?
  createdAt   DateTime       @default(now())

  @@index([requestId])
}
